{{!--
  One row in a spell list, shared by the creation and level-up spell steps.

  The `data-*` attributes are the client-side filter's whole input — the shell matches them without
  re-rendering (see CreatorShellBase#_applySpellFilters), so every filterable axis has to be here
  even when the meta line below doesn't show it.

  The meta line is a fixed set, not a configurable one: level, school, components, and the two tags
  that change how a spell plays. Before it existed a row was an icon and a name, and every attribute
  a player might be choosing on was a click away — the hover tooltip answers "tell me about this
  one", not "which of these thirty".

  Level-up rows carry two extra states the creation step has no equivalent of: `owned` (a spell the
  character already has, offered as a swap-out candidate) and `swapMarked` (one picked for
  replacement). Both come through untouched when absent.
--}}
<li>
  <button type="button"
          class="creator-pickrow creator-spellrow {{#if active}}is-selected{{/if}} {{#if owned}}is-owned{{/if}} {{#if swapMarked}}is-swapping{{/if}} {{#if focused}}is-focused{{/if}} {{#if disabled}}is-disabled{{/if}}"
          data-action="stepAction" data-step-action="focus-spell"
          data-uuid="{{uuid}}" data-name="{{name}}" data-level="{{level}}" data-school="{{school}}"
          data-props="{{propertyKeys}}" data-casting="{{castingTimeKey}}" data-range="{{rangeKey}}"
          data-tooltip="{{ccItemTooltip uuid}}">
    <img class="creator-pickrow-img" src="{{img}}" alt="">
    <span class="creator-spellrow-text">
      <span class="creator-pickrow-name">{{name}}</span>
      <span class="creator-spellrow-meta">
        {{#if levelLabel}}<span class="creator-spellrow-level">{{levelLabel}}</span>{{/if}}
        {{#if school}}<span>{{school}}</span>{{/if}}
        {{#if castingTime}}<span>{{castingTime}}</span>{{/if}}
        {{#if range}}<span>{{range}}</span>{{/if}}
        {{#if components}}<span>{{components}}</span>{{/if}}
        {{#if isConcentration}}
        <span class="creator-spellrow-tag" data-tooltip="{{localize 'sogrom-dnd5e-character-creator.step.spells.concentration'}}">
          <i class="fa-solid fa-circle-dot" aria-hidden="true"></i>{{localize "sogrom-dnd5e-character-creator.step.spells.concentration"}}
        </span>
        {{/if}}
        {{#if isRitual}}
        <span class="creator-spellrow-tag" data-tooltip="{{localize 'sogrom-dnd5e-character-creator.step.spells.ritual'}}">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>{{localize "sogrom-dnd5e-character-creator.step.spells.ritual"}}
        </span>
        {{/if}}
      </span>
    </span>
    {{#if active}}
    <i class="creator-pickrow-tick fa-solid fa-check"
       data-tooltip="{{localize 'sogrom-dnd5e-character-creator.step.spells.chosenTip'}}"></i>
    {{/if}}
  </button>
  {{!-- The right-hand column: the compare pin, and under it the state flag for a spell that is
        already on the sheet.

        Both sit *beside* the row, never inside it — the row is itself a button, and a button inside
        a button is invalid markup that browsers silently unnest, which would leave the pin firing
        the pick. Same reasoning, same markup as the class/species pickers.

        The flag lives here rather than on the row's own line because the list is a grid of 224px
        cards: on the line it took about a quarter of one, which is most of the name's share, and
        "Chromatic Orb" wrapped as "Chroma / tic Orb". Stacked under the pin it shares a column the
        card already spends, and the name keeps its width. Its tooltip is the sentence the one word
        cannot fit; the wording arrives on the row because it follows the caster — a 2014 prepared
        class reads "Prepared", a spells-known class "Known" ({@link module:data/spell-swap}). --}}
  <div class="creator-rowside">
    {{#if compareCategory}}
    <button type="button" class="creator-pin {{#if pinned}}is-pinned{{/if}}"
            data-action="togglePin" data-category="{{compareCategory}}" data-uuid="{{uuid}}"
            aria-pressed="{{#if pinned}}true{{else}}false{{/if}}"
            data-tooltip="{{#if pinned}}{{localize "sogrom-dnd5e-character-creator.compare.unpin"}}{{else}}{{localize "sogrom-dnd5e-character-creator.compare.pin"}}{{/if}}"
            aria-label="{{localize "sogrom-dnd5e-character-creator.compare.pinAria" name=name}}">
      <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
    </button>
    {{/if}}
    {{#if owned}}
      {{#if swapMarked}}
      <span class="creator-pickrow-flag is-swapping" data-tooltip="{{swapTip}}">{{swapTag}}</span>
      {{else}}
      <span class="creator-pickrow-flag" data-tooltip="{{ownedTip}}">{{ownedTag}}</span>
      {{/if}}
    {{/if}}
  </div>
</li>
