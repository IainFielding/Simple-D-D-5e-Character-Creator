<section class="creator-levelup creator-levelup-asi">
  {{#each sections}}
  {{!-- One layout for both cases so the ability boxes never move: the description column on the left
        (a feat, or the ASI placeholder), the stacked ability scores pinned in the aside on the right. --}}
  <div class="creator-asi-section creator-pick creator-pick--asi" data-index="{{index}}">

    <div class="creator-pick-desc">
      {{#if picking}}
      {{!-- `data-density` sizes the cards in the grids below; the ASI block's own density is "form",
            for the ability steppers, so the picker declares its own. See creator.css density tiers. --}}
      <div class="creator-levelup-choices creator-asi-feat-picker" data-density="{{pickerDensity}}">
        <div class="creator-choice-section">
          <header class="creator-choice-head">
            <h2>{{localize "sogrom-dnd5e-character-creator.levelup.step.asi.pickFeat"}}</h2>
          </header>

          {{!-- Name search plus "shows feats that increase X". Both filter the cards in the DOM
                (see CreatorShellBase#_applyFeatFilters) rather than re-rendering, so typing keeps
                focus; their values live on the state so a "coming later" peek doesn't wipe them.
                The dropdown appears only when some feat on screen raises an ability at all. --}}
          <div class="creator-feat-search-row">
            <label class="creator-search">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input type="search" data-feat-search autocomplete="off"
                     aria-label="{{localize 'sogrom-dnd5e-character-creator.common.search'}}"
                     placeholder="{{localize 'sogrom-dnd5e-character-creator.levelup.step.asi.searchFeats'}}">
            </label>
            {{#if abilityOptions.length}}
            <label class="creator-spell-filter">
              <i class="fa-solid fa-dumbbell"></i>
              <select data-feat-filter-ability
                      aria-label="{{localize 'sogrom-dnd5e-character-creator.levelup.step.asi.filterAbilityAria'}}">
                <option value="">{{localize "sogrom-dnd5e-character-creator.levelup.step.asi.filterAnyAbility"}}</option>
                {{#each abilityOptions}}
                <option value="{{value}}">
                  {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.filterIncreases" ability=label}}
                </option>
                {{/each}}
              </select>
            </label>
            {{/if}}
          </div>

          {{#if groups}}
            {{#each groups}}
            <h3 class="creator-choice-group-head">{{label}}</h3>
            <ul class="creator-choice-grid">
              {{#each options}}
              <li>
                <button type="button" class="creator-choice-card {{#if recommended}}is-recommended{{/if}}"
                        data-action="stepAction" data-step-action="asiFeatPick"
                        data-index="{{../../index}}" data-uuid="{{uuid}}" data-tooltip="{{ccItemTooltip uuid}}"
                        data-name="{{name}}" data-abilities="{{abilityKeys}}">
                  {{#if recommended}}<i class="creator-choice-card-star fa-solid fa-star" aria-hidden="true"></i>{{/if}}
                  <img class="creator-choice-card-img" src="{{img}}" alt="">
                  <span class="creator-choice-card-name">{{name}}</span>
                </button>
              </li>
              {{/each}}
            </ul>
            {{/each}}
          {{else}}
            <ul class="creator-choice-grid">
              {{#each options}}
              <li>
                <button type="button" class="creator-choice-card"
                        data-action="stepAction" data-step-action="asiFeatPick"
                        data-index="{{../index}}" data-uuid="{{uuid}}" data-tooltip="{{ccItemTooltip uuid}}"
                        data-name="{{name}}" data-abilities="{{abilityKeys}}">
                  <img class="creator-choice-card-img" src="{{img}}" alt="">
                  <span class="creator-choice-card-name">{{name}}</span>
                </button>
              </li>
              {{/each}}
            </ul>
          {{/if}}

          {{!-- Shown by the filter pass when every card is hidden; there is no server-side empty
                state to render, because filtering never re-renders. --}}
          <p class="creator-choice-empty is-hidden" data-feat-empty>
            {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.noMatches"}}
          </p>

          {{#if hasLocked}}
          <button type="button" class="creator-btn creator-btn-ghost" data-action="stepAction" data-step-action="asiFeatPeek" data-index="{{index}}">
            {{#if showFuture}}
            <i class="fa-solid fa-eye-slash"></i> {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.hideLater"}}
            {{else}}
            <i class="fa-solid fa-eye"></i> {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.showLater"}}
            {{/if}}
          </button>
          {{#if showFuture}}
          <h3 class="creator-choice-group-head">{{localize "sogrom-dnd5e-character-creator.levelup.step.asi.comingLater"}}</h3>
          <ul class="creator-choice-grid">
            {{#each lockedOptions}}
            <li>
              <button type="button" class="creator-choice-card creator-choice-card--taken"
                      data-tooltip="{{ccItemTooltip uuid}}"
                      data-name="{{name}}" data-abilities="{{abilityKeys}}" disabled>
                <span class="creator-choice-card-badge">{{lockReason}}</span>
                <img class="creator-choice-card-img" src="{{img}}" alt="">
                <span class="creator-choice-card-name">{{name}}</span>
              </button>
            </li>
            {{/each}}
          </ul>
          {{/if}}
          {{/if}}

          <div class="creator-ability-actions">
            <button type="button" class="creator-btn creator-btn-ghost" data-action="stepAction" data-step-action="asiFeatCancel" data-index="{{index}}">
              {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.cancelPick"}}
            </button>
          </div>
        </div>
      </div>

      {{else if isFeat}}
      {{#if detail}}
      <article class="creator-detail">
        <header class="creator-detail-head">
          <img class="creator-detail-img" src="{{detail.img}}" alt="">
          <h2>{{detail.name}}</h2>
        </header>
        <div class="creator-detail-body">{{{detail.enriched}}}</div>
      </article>
      {{/if}}
      <div class="creator-ability-actions">
        <button type="button" class="creator-btn creator-btn-ghost" data-action="stepAction" data-step-action="asiFeat" data-index="{{index}}">
          <i class="fa-solid fa-repeat"></i> {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.changeFeat"}}
        </button>
        <button type="button" class="creator-btn creator-btn-ghost" data-action="stepAction" data-step-action="asiAbilities" data-index="{{index}}">
          {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.useAbilities"}}
        </button>
      </div>

      {{else}}
      <article class="creator-detail">
        <header class="creator-detail-head">
          <span class="creator-detail-icon"><i class="fa-solid fa-arrow-up"></i></span>
          <h2>{{localize "sogrom-dnd5e-character-creator.levelup.step.asi.improvementTitle"}}</h2>
        </header>
        <div class="creator-detail-body">
          {{#if hint}}<div class="creator-choice-hint">{{{hint}}}</div>{{/if}}
          <p>{{{improvementDesc}}}</p>
        </div>
      </article>
      {{#if allowFeat}}
      <div class="creator-ability-actions">
        <button type="button" class="creator-btn creator-btn-ghost" data-action="stepAction" data-step-action="asiFeat" data-index="{{index}}">
          <i class="fa-solid fa-medal"></i> {{localize "sogrom-dnd5e-character-creator.levelup.step.asi.takeFeat"}}
        </button>
      </div>
      {{/if}}
      {{/if}}
    </div>

    {{#unless picking}}
    <aside class="creator-class-aside">
      <h2 class="creator-aside-title">{{localize "sogrom-dnd5e-character-creator.step.originAbilities.label"}}</h2>
      {{#if hasChoice}}
      <p class="creator-asi-hint">{{localize "sogrom-dnd5e-character-creator.levelup.step.asi.hint" points=points cap=cap}}</p>
      <div class="creator-points">
        <span class="creator-points-value {{#if allSpent}}is-zero{{/if}}">{{remaining}}</span>
        <span class="creator-points-label">{{localize "sogrom-dnd5e-character-creator.step.abilities.pointsLeft"}}</span>
      </div>
      {{/if}}

      <ul class="creator-ability-list">
        {{#each rows}}
        <li class="creator-ability-row {{#if locked}}is-locked{{/if}} {{#if bonusLabel}}is-assigned{{/if}}">
          <span class="creator-ability-name">{{label}}</span>
          <div class="creator-stepper">
            <button type="button" class="creator-step-btn" data-action="stepAction" data-step-action="asiDec"
                    data-index="{{../stepIndex}}" data-key="{{key}}" {{#unless canDec}}disabled{{/unless}}>&minus;</button>
            <span class="creator-ability-score">
              {{total}}
              {{#if locked}}<i class="creator-ability-lock fa-solid fa-lock" title="{{localize 'sogrom-dnd5e-character-creator.levelup.step.asi.locked'}}"></i>{{/if}}
            </span>
            <button type="button" class="creator-step-btn" data-action="stepAction" data-step-action="asiInc"
                    data-index="{{../stepIndex}}" data-key="{{key}}" {{#unless canInc}}disabled{{/unless}}>+</button>
          </div>
          <span class="creator-ability-mod">{{bonusLabel}}</span>
        </li>
        {{/each}}
      </ul>
    </aside>
    {{/unless}}

  </div>
  {{/each}}
</section>
