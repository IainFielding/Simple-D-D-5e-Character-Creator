{{!-- Level-up subclass block (inside level.hbs): the same list+description layout as the creation
      class step, scoped to one class's subclasses. Cards fire pick-subclass; data from subclass-step.mjs. --}}
<section class="creator-pick creator-pick--solo">
  <!-- Left column: subclass picker -->
  <div class="creator-pick-side">
    <div class="creator-toolbar creator-toolbar--stacked">
      <span class="creator-count">{{localize "sogrom-dnd5e-character-creator.common.available"}}: {{count}}</span>
      {{!-- The subclass pick is the one this feature was built for: a level-3 character choosing
            between two archetypes is comparing whole progressions, and this pane shows one at a
            time. Same control and same grid as the creation pickers — see parts/compare.hbs. --}}
      {{#if compare}}
      <button type="button" class="creator-btn creator-btn-ghost creator-compare-btn"
              data-action="openCompare" data-category="{{compare.category}}"
              data-tooltip="{{compare.hint}}" {{#unless compare.canCompare}}disabled{{/unless}}>
        <i class="fa-solid fa-scale-balanced"></i>
        <span class="creator-compare-btn-label">{{compare.label}}</span>
      </button>
      {{/if}}
    </div>

    <ul class="creator-picklist">
      {{#each cards}}
      <li>
        <button type="button" class="creator-pickrow {{#if selected}}is-selected{{/if}}"
                data-action="stepAction" data-step-action="pick-subclass"
                data-index="{{../index}}" data-uuid="{{uuid}}" data-name="{{name}}">
          <img class="creator-pickrow-img" src="{{img}}" alt="">
          <span class="creator-pickrow-name">{{name}}</span>
          {{#if selected}}<i class="creator-pickrow-tick fa-solid fa-check"></i>{{/if}}
        </button>
        {{!-- A sibling of the row, not a child: the row is a button already. See work-picker.hbs. --}}
        {{#if ../compareCategory}}
        <button type="button" class="creator-pin {{#if pinned}}is-pinned{{/if}}"
                data-action="togglePin" data-category="{{../compareCategory}}" data-uuid="{{uuid}}"
                aria-pressed="{{#if pinned}}true{{else}}false{{/if}}"
                data-tooltip="{{#if pinned}}{{localize "sogrom-dnd5e-character-creator.compare.unpin"}}{{else}}{{localize "sogrom-dnd5e-character-creator.compare.pin"}}{{/if}}"
                aria-label="{{localize "sogrom-dnd5e-character-creator.compare.pinAria" name=name}}">
          <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
        </button>
        {{/if}}
      </li>
      {{else}}
      <p class="creator-empty">{{localize "sogrom-dnd5e-character-creator.common.noEntries"}}</p>
      {{/each}}
    </ul>
  </div>

  <!-- Right: subclass description + features -->
  <div class="creator-pick-desc">
    {{#if hasSelection}}
    <article class="creator-detail">
      {{!-- Deliberately not the shared parts/work-detail.hbs partial: this block shows its
            sourcebook as a header pill on the level block (blockSource), so rendering the partial
            would print the same provenance twice inside the article. --}}
      <header class="creator-detail-head">
        <img class="creator-detail-img" src="{{detail.img}}" alt="">
        <h2>{{detail.name}}</h2>
        {{#if sourceUuid}}
        <button type="button" class="creator-btn creator-btn-ghost creator-source-details-btn"
                data-action="openSourceDetails" data-uuid="{{sourceUuid}}"
                data-tooltip="{{localize "sogrom-dnd5e-character-creator.common.sourceDetails.tooltip"}}">
          <i class="fa-solid fa-book-open"></i>
          {{localize "sogrom-dnd5e-character-creator.common.sourceDetails.open"}}
        </button>
        {{/if}}
      </header>
      <div class="creator-detail-body">{{{detail.enriched}}}</div>

      {{#each groups}}
      <section class="creator-adv-block">
        <h3 class="creator-adv-heading">{{heading}}</h3>

        {{#if tags.length}}
        <ul class="creator-trait-list">
          {{#each tags}}
          <li class="creator-trait">
            <span class="creator-trait-label">{{label}}</span>
            <span class="creator-trait-value">{{value}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}

        {{#if items.length}}
        <div class="creator-grant-list">
          {{#each items}}
          <div class="creator-grant">
            <img class="creator-grant-icon" src="{{img}}" alt="">
            <a class="content-link" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}">{{name}}</a>
            {{#if level}}<span class="creator-grant-tag">{{localize "sogrom-dnd5e-character-creator.step.class.levelTag" level=level}}</span>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
      </section>
      {{/each}}
    </article>
    {{else}}
    <div class="creator-pick-empty">
      <i class="fa-solid fa-sitemap"></i>
      <h2>{{localize "sogrom-dnd5e-character-creator.levelup.step.subclass.label"}}</h2>
      <p>{{localize "sogrom-dnd5e-character-creator.levelup.step.subclass.intro"}}</p>
    </div>
    {{/if}}
  </div>
</section>
