{{!--
  The Class step. One work surface: the chosen class's page, with the ability allocator beneath it
  and the class picker available as a drawer over the top.

  What changed, and why. This used to be three columns — a 340px picker, a flexible description,
  and a 348px aside holding the target level and the whole ability panel. The ability scores are
  the most consequential numbers in character creation and they had the least room on the screen:
  the stylesheet had to tighten the row gaps, narrow the score box to 2rem and pin the three method
  tabs to `nowrap` just to fit "Standard Array" into the column. Meanwhile the description they
  were meant to be read alongside was being squeezed from the other side.

  The rule now is read on the left, write on the right: the dossier shows the resolved scores as a
  readout, and this surface is where they are set, at full width, with a budget meter that shows
  points being spent rather than a bare number counting down.

  Data from class-step.mjs context(): `cards`/`count`/`pickAction`/`drawerOpen` for the drawer,
  `detail`/`groups` for the page, `abilities` for the allocator, `targetLevel` for the level picker.
--}}
<section class="creator-work">

  {{!-- The switcher: what you chose, and the way back to the list. Replaces a permanently-open
        column with a control the width of its own label.

        It carries a chevron, so it reads as a disclosure — and now says so: aria-expanded tells
        a screen reader whether the list it controls is open, and aria-controls names it. The
        chevron alone told sighted users something no assistive technology could hear. --}}
  {{#if hasSelection}}
  <div class="creator-work-bar">
    <button type="button" class="creator-work-switch"
            data-action="openPicker"
            aria-expanded="{{#if drawerOpen}}true{{else}}false{{/if}}"
            aria-controls="creator-picker-drawer">
      <img class="creator-work-switch-img" src="{{detail.img}}" alt="">
      <span>{{detail.name}}</span>
      <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
    <span class="creator-work-bar-note">
      {{localize "sogrom-dnd5e-character-creator.common.available"}}: {{count}}
    </span>
  </div>
  {{/if}}

  {{!-- Left column: the class list, and the chosen class's page under it. --}}
  <div class="creator-work-body">
    <div class="creator-work-page">
      {{#if hasSelection}}
      {{> "modules/sogrom-dnd5e-character-creator/templates/parts/work-detail.hbs" this}}
      {{/if}}
    </div>

    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/work-picker.hbs" this}}
  </div>

  {{!--
    Right column: the things this step asks you to *set*, as opposed to the class page on the
    left, which is what you read.

    It is a sibling of the body rather than part of the page, and that is the whole point: the
    picker drawer covers the body only, so opening the class list never takes the ability scores
    off screen, and choosing a class never replaces them. They were inside the page before, which
    put them below the class description and its entire feature table — a couple of screens down
    on a large monitor, for the one control the footer blocks Next on — and, while the drawer was
    open with nothing chosen, below the class list as well.

    Starting Level lives here too: it is a decision, not a description.
  --}}
  <aside class="creator-work-side">
    {{#if hasSelection}}
    {{#with targetLevel}}
    {{!--
      Target level: the creator always builds a level-1 character; anything above 1 hands off to
      the level-up wizard after Create (see class-step.mjs targetLevelContext / creator-shell
      #onFinish). Presets cover the common picks; the custom field carries everything else up to
      the system cap.
    --}}
    <section class="creator-work-block creator-target-level">
      <h3 class="creator-work-block-title">{{localize "sogrom-dnd5e-character-creator.step.class.targetLevel.label"}}</h3>
      <div class="creator-level-chips">
        {{#each presets}}
        <button type="button" class="creator-level-chip {{#if active}}is-active{{/if}}"
                data-action="stepAction" data-step-action="target-level" data-level="{{level}}"
                aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{level}}</button>
        {{/each}}
        <label class="creator-level-custom {{#if custom}}is-active{{/if}}">
          <span>{{localize "sogrom-dnd5e-character-creator.step.class.targetLevel.custom"}}</span>
          <input type="number" min="1" max="{{max}}" step="1" value="{{customValue}}"
                 data-step-change="target-level-custom"
                 aria-label="{{localize 'sogrom-dnd5e-character-creator.step.class.targetLevel.custom'}}">
        </label>
      </div>
      <p class="creator-level-hint">
        {{#if aboveOne}}
        {{localize "sogrom-dnd5e-character-creator.step.class.targetLevel.hintAbove" level=value}}
        {{else}}
        {{localize "sogrom-dnd5e-character-creator.step.class.targetLevel.hintOne"}}
        {{/if}}
      </p>
    </section>
    {{/with}}
    {{/if}}

    {{!-- Rendered whether or not a class is chosen: ability scores do not depend on the class,
          and a player who wants to roll first and pick after should not be blocked. --}}
    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/abilities-panel.hbs" abilities}}
  </aside>
</section>
