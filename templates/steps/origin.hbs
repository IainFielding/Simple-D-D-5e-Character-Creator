{{!--
  Shared template for the origin picks that aren't the class — currently Species. One work surface
  carrying the chosen origin's page, its ability increase (where its edition grants one), and the
  option list as a drawer over the top. See parts/work-picker.hbs for why the picker is a drawer
  and not a column.

  Data from origin-step.mjs context(): `cards`/`count`/`pickAction`/`drawerOpen` for the drawer,
  `detail`/`groups` for the page, and `abilities` — the shared ability-increase panel, present only
  when the chosen origin actually grants an increase (a 2014 species does; a 2024 one does not).
--}}
<section class="creator-work">

  {{#if hasSelection}}
  <div class="creator-work-bar">
    {{!-- Disclosure semantics for the chevron — see class.hbs. --}}
    <button type="button" class="creator-work-switch"
            data-action="openPicker"
            aria-expanded="{{#if drawerOpen}}true{{else}}false{{/if}}"
            aria-controls="creator-picker-drawer">
      <img class="creator-work-switch-img" src="{{detail.img}}" alt="">
      <span>{{detail.name}}</span>
      <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
    <span class="creator-work-bar-note">
      {{localize "sogrom-dnd5e-character-creator.common.available"}}: {{count}}
    </span>
    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/rules-link.hbs" this}}
  </div>
  {{/if}}

  <div class="creator-work-body">
    <div class="creator-work-page">
      {{#if hasSelection}}
      {{> "modules/sogrom-dnd5e-character-creator/templates/parts/work-detail.hbs" this}}
      {{/if}}
    </div>

    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/work-picker.hbs" this}}
  </div>

  {{!-- Right column: what this step asks you to set, beside what you read. Absent entirely when
        this origin's edition grants no ability increase, and the page then takes the full width.
        See class.hbs for why it sits outside the body. --}}
  {{#if abilities}}
  <aside class="creator-work-side">
    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/origin-abilities.hbs" abilities}}
  </aside>
  {{/if}}
</section>
